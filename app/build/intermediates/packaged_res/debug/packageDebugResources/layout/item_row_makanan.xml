<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:layout_marginHorizontal="0dp"
    android:layout_marginBottom="10dp"
    android:padding="14dp"
    android:background="@drawable/bg_card_white"
    android:gravity="center_vertical"
    android:elevation="1dp">

    <!-- Food thumbnail (square rounded) -->
    <ImageView
        android:id="@+id/img_item_photo"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginEnd="14dp"
        android:background="@drawable/bg_thumbnail"
        android:scaleType="centerCrop"
        android:clipToOutline="true"
        tools:src="@drawable/bakso" />

    <!-- Name + description -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_item_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/nds_on_surface"
            android:letterSpacing="-0.01"
            tools:text="Bakso" />

        <TextView
            android:id="@+id/tv_item_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:textSize="12sp"
            android:textColor="@color/nds_on_surface_medium"
            android:maxLines="2"
            android:ellipsize="end"
            android:lineSpacingMultiplier="1.4"
            tools:text="Bola daging sapi dengan kuah kaldu gurih hangat" />

        <!-- Category tag -->
        <TextView
            android:id="@+id/tv_item_tag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:text="@string/label_berkuah"
            android:textSize="11sp"
            android:textColor="@color/nds_tag_text"
            android:background="@drawable/bg_tag"
            android:paddingHorizontal="10dp"
            android:paddingVertical="3dp" />

    </LinearLayout>

    <!-- Rating on right -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="★"
            android:textSize="13sp"
            android:textColor="@color/nds_star" />

        <TextView
            android:id="@+id/tv_item_rating"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"
            android:text="4.8"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/nds_on_surface" />

    </LinearLayout>

</LinearLayout>